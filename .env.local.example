# Supabase — vedi .claude/PROJECT.md §12 per il progetto (eu-central-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key Supabase — server-only, mai esposta al client.
# Usata solo in lib/supabase/admin.ts per creare il profilo subito dopo
# supabase.auth.signUp() (l'id utente proviene dalla risposta Supabase,
# non da input client). Vedi DEC-010.
SUPABASE_SECRET_KEY=

# Resend — invio dell'email di consenso genitoriale (DEC-011).
RESEND_API_KEY=
# Mittente verificato su Resend (dominio o indirizzo).
RESEND_FROM_EMAIL=

# URL pubblico del sito, usato per costruire il link di conferma consenso
# (/consenso/[token]) inserito nell'email al genitore/tutore.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
